# Copie para .env.local (não vai pro GitHub) ou cadastre na Vercel em Settings > Environment Variables.
# Sem essas duas variáveis o CRM roda no modo demonstração (dados só no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-publica-anon-ou-publishable

# --- Disparos WhatsApp (API oficial da Meta) ---
# Só no servidor: cadastre na Vercel (Settings > Environment Variables). NUNCA com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=chave-secreta-service-role-do-supabase
WHATSAPP_TOKEN=token-permanente-do-usuario-do-sistema
WHATSAPP_PHONE_ID=id-do-numero-de-telefone
WHATSAPP_WABA_ID=id-da-conta-whatsapp-business
WHATSAPP_APP_SECRET=chave-secreta-do-app-meta
WHATSAPP_VERIFY_TOKEN=invente-uma-senha-para-o-webhook
# WHATSAPP_API_VERSION=v23.0
